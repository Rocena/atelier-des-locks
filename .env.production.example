# ---------------------------------------------------------------
# L'Atelier des Locks : réglages de PRODUCTION
# Sur le serveur : copier ce fichier en « .env » (cp .env.production.example .env),
# puis remplacer chaque valeur marquée « À REMPLIR ». Ce fichier ne quitte JAMAIS le serveur
# (il contient des mots de passe) et n'est jamais envoyé sur GitHub ni par email.
# Guide pas à pas : docs/DEPLOIEMENT.md
# ---------------------------------------------------------------

# Utilisé par docker compose : toutes les commandes lisent ce fichier docker-compose.prod.yml
COMPOSE_FILE=docker-compose.prod.yml

# --- Site -------------------------------------------------------
# Votre nom de domaine, SANS « https:// » ni « www. » (exemple : atelierdeslocks.fr)
DOMAIN=À REMPLIR
# Adresse email pour le certificat HTTPS (Let's Encrypt vous prévient avant une expiration)
ACME_EMAIL=À REMPLIR

# --- Base de données -------------------------------------------
POSTGRES_USER=atelier
POSTGRES_DB=atelier_des_locks
# Mot de passe de la base : lettres et chiffres uniquement (pas de symboles).
# Générer :  openssl rand -hex 24
POSTGRES_PASSWORD=À REMPLIR

# --- Secrets de l'application -----------------------------------
# Signature des sessions et chiffrement des liens des rappels. Ne JAMAIS le changer après la mise
# en ligne sans prévenir : tout le monde serait déconnecté et les liens des rappels déjà
# planifiés cesseraient de fonctionner.
# Générer :  openssl rand -base64 48 | tr '+/' '-_' | tr -d '='
SESSION_SECRET=À REMPLIR
# Flux d'agenda privé (/agenda/<jeton>.ics) à ajouter à votre téléphone. Vide = flux désactivé.
# Générer :  openssl rand -base64 48 | tr '+/' '-_' | tr -d '='
ICAL_FEED_TOKEN=

# --- Emails et SMS (Brevo) ---------------------------------------
BREVO_API_KEY=À REMPLIR
# Adresse d'envoi VALIDÉE dans Brevo (avec SPF et DKIM), par exemple contact@votre-domaine.fr
BREVO_SENDER_EMAIL=À REMPLIR
BREVO_SENDER_NAME=L’Atelier des Locks
# Nom affiché sur les SMS : 11 caractères maximum, lettres et chiffres, sans espace
SMS_SENDER=AtelierLock
# Adresse qui reçoit l'alerte « nouveau rendez-vous » (la vôtre)
OWNER_EMAIL=À REMPLIR
# Lien « Laisser un avis Google » de votre fiche Google (peut rester vide au début)
GOOGLE_REVIEW_URL=

# --- Réservation ------------------------------------------------
# internal = le module de réservation du site ; fresha_link = boutons vers Fresha
BOOKING_PROVIDER=internal
FRESHA_BOOKING_URL=

# --- Sauvegardes chiffrées --------------------------------------
# Clé PUBLIQUE de chiffrement (commence par « age1 »). Voir docs/DEPLOIEMENT.md, étape 7.
# La clé PRIVÉE correspondante ne doit JAMAIS être sur le serveur.
BACKUP_AGE_RECIPIENTS=À REMPLIR
# Dossier des sauvegardes sur le serveur
BACKUP_PATH=./backups
# Heure de la sauvegarde (heure de Paris)
BACKUP_HOUR=03
BACKUP_MINUTE=30
# Copie hors serveur (FORTEMENT recommandée : un serveur détruit emporte ses sauvegardes).
# Exemple Scaleway (Paris) : BACKUP_REMOTE=offsite:nom-du-bucket
BACKUP_REMOTE=
RCLONE_CONFIG_OFFSITE_TYPE=
RCLONE_CONFIG_OFFSITE_PROVIDER=
RCLONE_CONFIG_OFFSITE_ACCESS_KEY_ID=
RCLONE_CONFIG_OFFSITE_SECRET_ACCESS_KEY=
RCLONE_CONFIG_OFFSITE_ENDPOINT=
RCLONE_CONFIG_OFFSITE_REGION=
# Adresse de supervision (facultatif) : un service du type Healthchecks.io vous écrit si aucune
# sauvegarde ne s'est terminée à temps.
BACKUP_PING_URL=
