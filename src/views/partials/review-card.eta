<%/* Carte d'avis. Paramètres : review, serviceName, fmt. */%>
<article class="review">
  <%~ include('./stars', { rating: it.review.rating, label: 'Note : ' + it.review.rating + ' sur 5' }) %>
  <blockquote class="review__text"><p><%= it.review.text %></p></blockquote>
<% if (it.review.hasPhoto) { %>
  <img class="review__photo" src="/avis/photos/<%= it.review.id %>" alt="Photo du résultat, partagée par <%= it.review.author %>" width="352" height="352" loading="lazy" decoding="async" />
<% } %>
<% if (it.review.ownerReply) { %>
  <div class="review__reply">
    <p class="review__reply-label">Réponse de L’Atelier des Locks</p>
    <p><%= it.review.ownerReply %></p>
  </div>
<% } %>
  <footer class="review__meta">
    <span>
      <span class="review__author"><%= it.review.author %></span>
<% if (it.serviceName) { %>
      <span class="review__service"> · <%= it.serviceName %></span>
<% } %>
    </span>
<% if (it.review.verified) { %>
    <span class="review__verified">
      <svg class="icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="m5 12 4.5 4.5L19 7" /></svg>
      Avis vérifié · <time datetime="<%= it.review.date %>"><%= it.fmt.formatDate(it.review.date) %></time>
    </span>
<% } %>
  </footer>
</article>
