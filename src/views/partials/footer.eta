<footer class="site-footer" data-surface="ebene">
  <div class="bogolan bogolan--dark" aria-hidden="true"></div>
  <div class="site-footer__inner">
    <div class="site-footer__brand">
      <img src="/brand/logo-vertical-sombre.svg" alt="L’Atelier des Locks" width="200" height="155" loading="lazy" />
      <p class="site-footer__pitch">Création, entretien et soin des locks, avec patience et savoir-faire.</p>
      <a class="btn btn--primary site-footer__cta" href="<%= it.bookingHref %>" data-magnetic>Réserver un rendez-vous</a>
    </div>

    <div class="site-footer__col">
      <h2 class="eyebrow">Le salon</h2>
      <!-- TODO-PROPRIO : adresse exacte -->
      <address class="site-footer__address">
        <%= it.site.address.street %><br />
        <%= it.site.address.postalCode %> <%= it.site.address.city %>
      </address>
      <ul class="site-footer__links" role="list">
        <li><a class="link link--quiet" href="/contact">Plan et accès</a></li>
<% if (it.site.whatsapp) { %>
        <li><a class="link link--quiet" href="<%= it.site.whatsapp %>" rel="noopener">WhatsApp</a></li>
<% } %>
<% if (it.site.instagram) { %>
        <li><a class="link link--quiet" href="<%= it.site.instagram %>" rel="noopener">Instagram</a></li>
<% } %>
        <!-- TODO-PROPRIO : liens WhatsApp et Instagram (src/server/lib/site.js) -->
      </ul>
    </div>

    <div class="site-footer__col">
      <h2 class="eyebrow">Horaires</h2>
      <!-- TODO-PROPRIO : horaires réels -->
      <dl class="hours">
<% it.site.hours.forEach(function (h) { %>
        <div class="hours__row"><dt><%= h.days %></dt><dd><%= h.time %></dd></div>
<% }) %>
      </dl>
    </div>

    <div class="site-footer__col">
      <h2 class="eyebrow">Explorer</h2>
      <ul class="site-footer__links" role="list">
<% it.site.nav.concat(it.site.secondaryNav).forEach(function (item) { %>
        <li><a class="link link--quiet" href="<%= item.href %>"><%= item.label %></a></li>
<% }) %>
      </ul>
    </div>
  </div>

  <div class="site-footer__legal">
    <p>© <%= new Date().getFullYear() %> L’Atelier des Locks · Toulouse</p>
    <ul class="site-footer__legal-links" role="list">
      <li><a class="link link--quiet" href="/mentions-legales">Mentions légales</a></li>
      <li><a class="link link--quiet" href="/confidentialite">Confidentialité</a></li>
      <li><a class="link link--quiet" href="/cgv-politique-rdv">Politique de rendez-vous</a></li>
    </ul>
  </div>
</footer>
