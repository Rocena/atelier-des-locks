<!doctype html>
<html lang="fr"<% if (it.settings && it.settings.announcement && it.settings.announcement.enabled) { %> data-announce="<%= it.settings.announcement.id %>"<% } %>>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title><%= it.title %></title>
    <meta name="description" content="<%= it.description %>" />
<% if (it.noindex) { %>
    <meta name="robots" content="noindex, nofollow" />
<% } else { %>
    <link rel="canonical" href="<%= it.canonical %>" />
<% } %>
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="fr_FR" />
    <meta property="og:site_name" content="L’Atelier des Locks" />
    <meta property="og:title" content="<%= it.title %>" />
    <meta property="og:description" content="<%= it.description %>" />
    <meta property="og:url" content="<%= it.canonical %>" />
    <meta property="og:image" content="<%= it.publicUrl %>/og-image.png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#F4ECE2" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#1C1310" media="(prefers-color-scheme: dark)" />
    <meta name="color-scheme" content="light dark" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <!-- Avant le premier rendu : thème (choix mémorisé, sinon préférence système) et loader
         d'entrée (une fois par session, jamais en mouvement réduit). -->
    <script nonce="<%= it.nonce %>">
      (function () {
        var d = document.documentElement, t = null, seen = true;
        try { t = localStorage.getItem('adl-theme'); } catch (e) {}
        if (t !== 'light' && t !== 'dark') t = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        d.dataset.theme = t;
        d.classList.add('js');
        try { seen = sessionStorage.getItem('adl-intro') === '1'; sessionStorage.setItem('adl-intro', '1'); } catch (e) {}
        try { if (d.dataset.announce && localStorage.getItem('adl-announce') === d.dataset.announce) d.classList.add('announce-closed'); } catch (e) {}
        if (!seen && !matchMedia('(prefers-reduced-motion: reduce)').matches) d.classList.add('has-intro');
      })();
    </script>
<% it.assets.fonts.forEach(function (href) { %>
    <link rel="preload" href="<%= href %>" as="font" type="font/woff2" crossorigin />
<% }) %>
<% it.assets.styles.forEach(function (href) { %>
    <link rel="stylesheet" href="<%= href %>" />
<% }) %>
<% it.assets.scripts.forEach(function (src) { %>
    <script type="module" src="<%= src %>"></script>
<% }) %>
<% it.jsonLd.forEach(function (json) { %>
    <script type="application/ld+json" nonce="<%= it.nonce %>"><%~ json %></script>
<% }) %>
  </head>
  <body class="<%= it.bodyClass || '' %>">
    <a class="skip-link" href="#contenu">Aller au contenu</a>
    <%~ include('../partials/intro', it) %>
    <%~ include('../partials/announcement', it) %>
    <%~ include('../partials/header', it) %>
    <main id="contenu" tabindex="-1">
<% if (it.breadcrumb) { %>
      <%~ include('../partials/breadcrumb', it) %>
<% } %>
<%~ it.body %>
    </main>
    <%~ include('../partials/footer', it) %>
    <%~ include('../partials/book-bar', it) %>
    <div class="cursor" data-cursor aria-hidden="true"></div>
  </body>
</html>
