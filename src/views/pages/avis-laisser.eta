<% layout('../layouts/base', it) %>
<%
  var fmt = it.fmt, state = it.state, errors = it.errors || {}, values = it.values || {};
  var errorList = Object.keys(errors);
  var stateTitles = {
    thanks: 'Merci *infiniment*.',
    used: 'Votre avis *est déjà envoyé*.',
    expired: 'Ce lien *a expiré*.',
    invalid: 'Ce lien *n’est pas valable*.',
  };
  var stateLeads = {
    thanks: 'Votre avis est bien reçu. Il sera relu par la propriétaire avant d’être publié sur le site.',
    used: 'Merci : un avis a déjà été déposé avec ce lien. Chaque lien ne sert qu’une fois.',
    expired: 'Les liens d’avis sont valables 30 jours après le rendez-vous. Il n’est plus possible de laisser un avis avec celui-ci.',
    invalid: 'Il a peut-être été mal copié. Vérifiez le lien reçu par email, ou contactez le salon.',
  };
%>
<%~ include('../partials/page-hero', {
  fmt: fmt,
  eyebrow: 'Votre avis',
  title: state === 'open' ? 'Comment s’est passé *votre rendez-vous* ?' : stateTitles[state],
  lead: state === 'open' ? 'Prestation : ' + it.view.serviceName + '. Deux minutes suffisent. Votre avis aide d’autres femmes à nous trouver.' : stateLeads[state]
}) %>

<section class="section review-form" aria-label="Laisser un avis">
  <div class="container review-form__layout">
<% if (state === 'open') { %>
<% if (errorList.length) { %>
    <div class="review-alert" role="alert" tabindex="-1" id="avis-erreurs">
      <p class="review-alert__title">Quelques champs sont à corriger.</p>
      <ul>
<% errorList.forEach(function (key) { %>
        <li><a class="link" href="#<%= key === 'rating' ? 'note-5' : key === 'body' ? 'avis-texte' : key === 'firstName' ? 'avis-prenom' : key === 'lastInitial' ? 'avis-initiale' : key === 'consent' ? 'avis-consentement' : 'avis-photo' %>"><%= errors[key] %></a></li>
<% }) %>
      </ul>
    </div>
<% } %>
    <form class="review-form__form" method="post" action="/avis/laisser/<%= it.token %>" enctype="multipart/form-data" novalidate>
      <input type="hidden" name="_csrf" value="<%= it.csrfToken %>" />

      <fieldset class="rating-input<%= errors.rating ? ' field--invalid' : '' %>">
        <legend class="field__label">Votre note</legend>
        <div class="rating-input__stars">
<% [5, 4, 3, 2, 1].forEach(function (n) { %>
          <input class="rating-input__radio" type="radio" id="note-<%= n %>" name="rating" value="<%= n %>"<% if (String(values.rating) === String(n)) { %> checked<% } %> required />
          <label class="rating-input__label" for="note-<%= n %>">
            <span class="visually-hidden"><%= n %> étoile<%= n > 1 ? 's' : '' %> sur 5</span>
            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M12 2.8l2.7 5.9 6.4.7-4.8 4.3 1.3 6.3L12 16.8 6.4 20l1.3-6.3-4.8-4.3 6.4-.7z" /></svg>
          </label>
<% }) %>
        </div>
<% if (errors.rating) { %><p class="field__message" id="note-erreur"><%= errors.rating %></p><% } %>
      </fieldset>

      <div class="field<%= errors.body ? ' field--invalid' : '' %>">
        <label class="field__label" for="avis-texte">Votre avis</label>
        <textarea class="field__control" id="avis-texte" name="body" rows="6" minlength="10" maxlength="1500" required aria-describedby="avis-texte-aide<%= errors.body ? ' avis-texte-erreur' : '' %>"<% if (errors.body) { %> aria-invalid="true"<% } %>><%= values.body %></textarea>
        <p class="field__hint" id="avis-texte-aide">Ce que vous avez aimé, le résultat, l’accueil… (10 à 1 500 caractères).</p>
<% if (errors.body) { %><p class="field__message" id="avis-texte-erreur"><%= errors.body %></p><% } %>
      </div>

      <div class="review-form__name">
        <div class="field<%= errors.firstName ? ' field--invalid' : '' %>">
          <label class="field__label" for="avis-prenom">Prénom affiché</label>
          <input class="field__control" id="avis-prenom" name="firstName" type="text" autocomplete="given-name" maxlength="40" required value="<%= values.firstName %>"<% if (errors.firstName) { %> aria-invalid="true" aria-describedby="avis-prenom-erreur"<% } %> />
<% if (errors.firstName) { %><p class="field__message" id="avis-prenom-erreur"><%= errors.firstName %></p><% } %>
        </div>
        <div class="field<%= errors.lastInitial ? ' field--invalid' : '' %>">
          <label class="field__label" for="avis-initiale">Initiale du nom</label>
          <input class="field__control review-form__initial" id="avis-initiale" name="lastInitial" type="text" maxlength="1" required value="<%= values.lastInitial %>"<% if (errors.lastInitial) { %> aria-invalid="true" aria-describedby="avis-initiale-erreur"<% } %> />
<% if (errors.lastInitial) { %><p class="field__message" id="avis-initiale-erreur"><%= errors.lastInitial %></p><% } %>
        </div>
      </div>
      <p class="field__hint review-form__name-hint">Seuls ce prénom et cette initiale seront publiés, par exemple « Awa D. ».</p>

      <div class="field<%= errors.photo ? ' field--invalid' : '' %>">
        <label class="field__label" for="avis-photo">Photo du résultat <span class="field__optional">(facultatif)</span></label>
        <input class="field__control" id="avis-photo" name="photo" type="file" accept="image/jpeg,image/png,image/webp" aria-describedby="avis-photo-aide<%= errors.photo ? ' avis-photo-erreur' : '' %>" />
        <p class="field__hint" id="avis-photo-aide">JPEG, PNG ou WebP, 8 Mo au plus. Elle ne sera publiée que si vous cochez la case ci-dessous et si la propriétaire valide votre avis.</p>
<% if (errors.photo) { %><p class="field__message" id="avis-photo-erreur"><%= errors.photo %></p><% } %>
      </div>

      <div class="review-hp" aria-hidden="true">
        <label for="avis-site">Site web</label>
        <input id="avis-site" name="website" type="text" tabindex="-1" autocomplete="off" />
      </div>

      <div class="field<%= errors.consent ? ' field--invalid' : '' %>">
        <label class="check">
          <input id="avis-consentement" type="checkbox" name="consent" required<% if (errors.consent) { %> aria-invalid="true" aria-describedby="avis-consentement-erreur"<% } %> />
          <span>J’accepte que mon avis, mon prénom suivi de l’initiale de mon nom et ma photo (si je l’ajoute) soient publiés sur le site de L’Atelier des Locks. Je peux demander leur retrait à tout moment depuis la page <a class="link" href="/contact">Contact</a>.</span>
        </label>
<% if (errors.consent) { %><p class="field__message" id="avis-consentement-erreur"><%= errors.consent %></p><% } %>
      </div>

      <div class="review-form__actions">
        <button class="btn btn--primary" type="submit">Envoyer mon avis</button>
        <p class="text-muted">Votre avis est relu avant publication. <a class="link" href="/confidentialite">Confidentialité</a>.</p>
      </div>
    </form>
<% } else { %>
    <div class="review-form__closed">
<% if (state === 'thanks' && it.googleReviewUrl) { %>
      <h2 class="review-form__subtitle">Et si vous le <em>partagiez</em> aussi sur Google ?</h2>
      <p>Cela nous aide à être trouvées par d’autres femmes de Toulouse. C’est facultatif, et ça prend une minute.</p>
      <a class="btn btn--secondary" href="<%= it.googleReviewUrl %>" target="_blank" rel="noopener noreferrer"><span class="btn__label">Laisser un avis Google<span class="visually-hidden"> (nouvel onglet)</span></span></a>
<% } %>
      <div class="review-form__links">
        <a class="btn btn--ghost" href="/avis"><span class="btn__label">Lire les avis</span></a>
<% if (state !== 'thanks' && state !== 'used') { %>
        <a class="btn btn--primary" href="/contact">Contacter le salon</a>
<% } %>
      </div>
    </div>
<% } %>
  </div>
</section>
