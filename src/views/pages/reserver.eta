<% layout('../layouts/base', it) %>
<%
  var fmt = it.fmt, c = it.catalog;
  var groups = c.categories.map(function (cat) {
    return { slug: cat.slug, name: cat.name, services: c.services.filter(function (s) { return s.category === cat.slug; }) };
  }).concat([{ slug: 'sur-mesure', name: 'Sur mesure', services: c.services.filter(function (s) { return !s.category; }) }])
    .filter(function (g) { return g.services.length > 0; });
  var steps = ['Prestation', 'Créneau', 'Coordonnées', 'Confirmation'];
%>
<%~ include('../partials/page-hero', { fmt: fmt, sun: true, eyebrow: 'Réserver', title: 'Votre rendez-vous, *en quatre étapes*.', lead: 'Choisissez votre prestation et votre créneau, laissez vos coordonnées : vous recevez aussitôt un lien pour ajouter le rendez-vous à votre agenda, le déplacer ou l’annuler.' }) %>

<section class="section booking" aria-labelledby="titre-page" data-booking>
  <script type="application/json" id="booking-data"><%~ it.bookingJson %></script>
  <div class="container">
    <noscript>
      <div class="booking-alert" role="note">
        <p class="booking-alert__title">La réservation en ligne a besoin de JavaScript.</p>
        <p>Activez-le dans votre navigateur, ou <a class="link" href="/contact">écrivez-nous</a> pour fixer votre rendez-vous.</p>
      </div>
    </noscript>

    <ol class="booking-progress" role="list" data-progress>
<% steps.forEach(function (label, i) { %>
      <li class="booking-progress__item<%= i === 0 ? ' is-current' : '' %>" data-progress-item="<%= i + 1 %>"<% if (i === 0) { %> aria-current="step"<% } %>>
        <span class="booking-progress__index" aria-hidden="true"><%= i + 1 %></span>
        <span class="booking-progress__label"><span class="visually-hidden">Étape <%= i + 1 %> sur 4 : </span><%= label %></span>
      </li>
<% }) %>
    </ol>

    <div class="booking__layout">
      <form class="booking__form" id="booking-form" method="post" action="/api/booking/appointments" enctype="multipart/form-data" novalidate data-csrf="<%= it.csrfToken %>">

        <!-- ─── Étape 1 : prestation ─────────────────────────────────────── -->
        <section class="booking-step" data-step="1" aria-labelledby="etape-1-titre">
          <h2 class="booking-step__title" id="etape-1-titre" tabindex="-1">Choisissez <em>votre prestation</em>.</h2>
          <p class="booking-step__lead text-muted">Durées et prix sont estimés : ils dépendent de la longueur et de la densité de vos cheveux. La locticienne vous confirme le prix exact en début de rendez-vous.</p>

<% groups.forEach(function (g) { %>
          <fieldset class="booking-group">
            <legend class="booking-group__title"><%= g.name %></legend>
            <div class="booking-group__list">
<% g.services.forEach(function (s) { %>
<% if (s.bookable) { %>
              <label class="service-choice">
                <input class="service-choice__input" type="radio" name="service" value="<%= s.slug %>"<% if (it.preselect === s.slug) { %> checked<% } %> required />
                <span class="service-choice__name"><%= s.name %></span>
                <span class="service-choice__meta num"><%= fmt.formatDuration(s.durationMin, s.durationMax) %> · <%= fmt.formatPrice(s) %></span>
                <span class="service-choice__summary"><%= s.summary %></span>
              </label>
<% } else { %>
              <div class="service-choice service-choice--offline">
                <span class="service-choice__name"><%= s.name %></span>
                <span class="service-choice__meta num"><%= fmt.formatDuration(s.durationMin, s.durationMax) %> · <%= fmt.formatPrice(s) %></span>
                <a class="link service-choice__link" href="<%= s.onQuote ? '/contact' : '/prestations/consultation-diagnostic' %>"><%= s.onQuote ? 'Sur devis : nous écrire' : 'Après une consultation' %><span class="visually-hidden"> pour <%= s.name %></span></a>
              </div>
<% } %>
<% }) %>
            </div>
          </fieldset>
<% }) %>

          <div class="booking-options" data-options hidden>
            <fieldset class="booking-group">
              <legend class="booking-group__title">Options <span class="field__optional">(facultatif)</span></legend>
              <div class="booking-options__list" data-options-list></div>
            </fieldset>
          </div>
          <p class="booking-note" data-allergy hidden>Cette prestation demande un <strong>test d’allergie 48 h avant</strong> le rendez-vous. Nous vous contactons pour l’organiser.</p>

          <p class="field__message booking-step__error" id="etape-1-erreur" data-step-error role="alert"></p>
          <div class="booking-step__actions">
            <button class="btn btn--primary" type="button" data-next>Choisir un créneau <span class="btn__arrow" aria-hidden="true">→</span></button>
          </div>
        </section>

        <!-- ─── Étape 2 : date et heure ──────────────────────────────────── -->
        <section class="booking-step" data-step="2" aria-labelledby="etape-2-titre" hidden>
          <h2 class="booking-step__title" id="etape-2-titre" tabindex="-1">Choisissez <em>votre créneau</em>.</h2>
          <p class="booking-step__lead text-muted" data-duration-note></p>

          <div class="calendar" data-calendar>
            <div class="calendar__head">
              <button class="icon-btn calendar__nav" type="button" data-month-prev aria-label="Mois précédent">←</button>
              <p class="calendar__month" data-month-label aria-live="polite"></p>
              <button class="icon-btn calendar__nav" type="button" data-month-next aria-label="Mois suivant">→</button>
            </div>
            <div class="calendar__body" data-calendar-body aria-busy="true">
              <table class="calendar__grid">
                <caption class="visually-hidden" id="calendrier-legende">Jours du mois : flèches pour se déplacer, Entrée pour choisir un jour.</caption>
                <thead>
                  <tr>
<% ['lundi', 'mardi', 'mercredi', 'jeudi', 'vendredi', 'samedi', 'dimanche'].forEach(function (d) { %>
                    <th scope="col" abbr="<%= d %>"><span aria-hidden="true"><%= d.slice(0, 3) %>.</span></th>
<% }) %>
                  </tr>
                </thead>
                <tbody data-calendar-days></tbody>
              </table>
              <div class="calendar__state" data-calendar-state hidden></div>
            </div>
          </div>

          <fieldset class="slots" data-slots hidden>
            <legend class="slots__title" data-slots-title></legend>
            <div class="slots__groups" data-slots-list></div>
          </fieldset>

          <p class="field__message booking-step__error" id="etape-2-erreur" data-step-error role="alert"></p>
          <div class="booking-step__actions">
            <button class="btn btn--ghost" type="button" data-back><span class="btn__label">Retour</span></button>
            <button class="btn btn--primary" type="button" data-next>Continuer <span class="btn__arrow" aria-hidden="true">→</span></button>
          </div>
        </section>

        <!-- ─── Étape 3 : informations ───────────────────────────────────── -->
        <section class="booking-step" data-step="3" aria-labelledby="etape-3-titre" hidden>
          <h2 class="booking-step__title" id="etape-3-titre" tabindex="-1">Faisons <em>connaissance</em>.</h2>
          <p class="booking-step__lead text-muted">Tous les champs sont obligatoires, sauf mention contraire.</p>

          <div class="booking-alert booking-alert--error" data-form-error role="alert" tabindex="-1" hidden></div>

          <div class="booking-fields">
            <div class="field">
              <label class="field__label" for="resa-prenom">Prénom</label>
              <input class="field__control" id="resa-prenom" name="firstName" type="text" autocomplete="given-name" maxlength="80" required aria-describedby="resa-prenom-erreur" />
              <p class="field__message" id="resa-prenom-erreur" data-error-for="firstName"></p>
            </div>
            <div class="field">
              <label class="field__label" for="resa-nom">Nom</label>
              <input class="field__control" id="resa-nom" name="lastName" type="text" autocomplete="family-name" maxlength="80" required aria-describedby="resa-nom-erreur" />
              <p class="field__message" id="resa-nom-erreur" data-error-for="lastName"></p>
            </div>
            <div class="field">
              <label class="field__label" for="resa-email">Email</label>
              <input class="field__control" id="resa-email" name="email" type="email" autocomplete="email" inputmode="email" maxlength="254" required aria-describedby="resa-email-aide resa-email-erreur" />
              <p class="field__hint" id="resa-email-aide">Pour la confirmation et le lien de gestion du rendez-vous.</p>
              <p class="field__message" id="resa-email-erreur" data-error-for="email"></p>
            </div>
            <div class="field">
              <label class="field__label" for="resa-tel">Téléphone</label>
              <input class="field__control" id="resa-tel" name="phone" type="tel" autocomplete="tel" inputmode="tel" maxlength="40" required aria-describedby="resa-tel-aide resa-tel-erreur" />
              <p class="field__hint" id="resa-tel-aide">06 12 34 56 78, ou au format international (+32…).</p>
              <p class="field__message" id="resa-tel-erreur" data-error-for="phone"></p>
            </div>
            <div class="field booking-fields__full">
              <label class="field__label" for="resa-cheveux">État actuel de vos cheveux</label>
              <select class="field__control" id="resa-cheveux" name="hairState" required aria-describedby="resa-cheveux-erreur">
                <option value="">Choisissez…</option>
<% Object.keys(it.hairStates).forEach(function (key) { %>
                <option value="<%= key %>"><%= it.hairStates[key] %></option>
<% }) %>
              </select>
              <p class="field__message" id="resa-cheveux-erreur" data-error-for="hairState"></p>
            </div>
            <div class="field booking-fields__full photo-field" data-photo-field>
              <span class="field__label" id="resa-photo-label">Photo de vos cheveux <span class="field__optional">(facultatif, conseillé)</span></span>
              <p class="field__hint" id="resa-photo-aide">Une photo nette, de dos ou de profil, aide la locticienne à préparer votre rendez-vous. JPEG, PNG ou WebP, 8 Mo au plus. Elle n’est visible que par le salon.</p>
              <div class="photo-field__row">
                <label class="btn btn--secondary btn--sm photo-field__pick" for="resa-photo">Ajouter une photo</label>
                <input class="photo-field__input" id="resa-photo" name="photo" type="file" accept="image/jpeg,image/png,image/webp" aria-labelledby="resa-photo-label" aria-describedby="resa-photo-aide resa-photo-erreur" />
                <figure class="photo-field__preview" data-photo-preview hidden>
                  <img alt="Aperçu de votre photo" data-photo-img width="64" height="64" />
                  <figcaption data-photo-name></figcaption>
                </figure>
                <button class="btn btn--ghost btn--sm" type="button" data-photo-remove hidden><span class="btn__label">Retirer la photo</span></button>
              </div>
              <p class="field__message" id="resa-photo-erreur" data-error-for="photo"></p>
            </div>
            <div class="field booking-fields__full">
              <label class="field__label" for="resa-notes">Un mot pour la locticienne <span class="field__optional">(facultatif)</span></label>
              <textarea class="field__control" id="resa-notes" name="notes" rows="4" maxlength="1000" aria-describedby="resa-notes-aide resa-notes-erreur"></textarea>
              <p class="field__hint" id="resa-notes-aide">Méthode souhaitée, épaisseur des locks, contrainte d’horaire, cuir chevelu sensible…</p>
              <p class="field__message" id="resa-notes-erreur" data-error-for="notes"></p>
            </div>
          </div>

          <div class="booking-consents">
            <div class="booking-policy">
              <p class="booking-policy__title">Politique de rendez-vous</p>
              <p><%= it.policyText %></p>
              <p><a class="link" href="/cgv-politique-rdv" target="_blank" rel="noopener">Lire la politique complète<span class="visually-hidden"> (nouvel onglet)</span></a></p>
            </div>
            <label class="check">
              <input id="resa-policy" type="checkbox" name="policy" required aria-describedby="resa-policy-erreur" />
              <span>J’accepte la politique de rendez-vous.</span>
            </label>
            <p class="field__message" id="resa-policy-erreur" data-error-for="policy"></p>
            <label class="check">
              <input type="checkbox" name="smsReminders" checked />
              <span>Recevoir les confirmations et rappels par SMS.</span>
            </label>
            <label class="check">
              <input type="checkbox" name="newsletter" />
              <span>Recevoir la lettre du salon : conseils d’entretien et disponibilités, une à deux fois par mois. <span class="text-muted">Désinscription en un clic.</span></span>
            </label>
          </div>

          <!-- Pot de miel : masqué aux humains et aux lecteurs d'écran, rempli par les robots. -->
          <div class="booking-hp" aria-hidden="true">
            <label for="resa-site">Site web</label>
            <input id="resa-site" name="website" type="text" tabindex="-1" autocomplete="off" />
          </div>

          <p class="booking-legal text-muted">Vos données servent uniquement à gérer votre rendez-vous. <a class="link" href="/confidentialite">Confidentialité</a>.</p>
          <div class="booking-step__actions">
            <button class="btn btn--ghost" type="button" data-back><span class="btn__label">Retour</span></button>
            <button class="btn btn--primary" type="submit" data-submit>
              <span>Confirmer le rendez-vous</span>
              <span class="btn__loader" aria-hidden="true"><span></span><span></span><span></span></span>
            </button>
          </div>
        </section>

        <!-- ─── Étape 4 : confirmation ───────────────────────────────────── -->
        <section class="booking-step booking-done" data-step="4" aria-labelledby="etape-4-titre" hidden>
          <h2 class="booking-step__title" id="etape-4-titre" tabindex="-1" data-done-title>C’est <em>noté</em>.</h2>
          <p class="lead" data-done-lead></p>
          <dl class="booking-done__recap" data-done-recap></dl>
          <div class="booking-done__actions">
            <a class="btn btn--primary" data-done-manage href="/">Gérer mon rendez-vous</a>
            <a class="btn btn--secondary" data-done-ics href="/" download>Ajouter à mon agenda (.ics)</a>
            <a class="btn btn--ghost" data-done-google href="/" target="_blank" rel="noopener noreferrer"><span class="btn__label">Google Agenda<span class="visually-hidden"> (nouvel onglet)</span></span></a>
          </div>
          <p class="booking-note">Gardez précieusement le lien « Gérer mon rendez-vous » : il vous permet de déplacer ou d’annuler gratuitement jusqu’à <span data-done-hours><%= c.cancellationHours %></span> h avant.</p>
          <h3 class="booking-done__subtitle">Pour bien <em>préparer</em> votre venue</h3>
          <ul class="booking-done__tips" role="list" data-done-tips></ul>
        </section>
      </form>

      <aside class="booking-summary" aria-labelledby="recap-titre" data-summary>
        <h2 class="booking-summary__title" id="recap-titre">Votre rendez-vous</h2>
        <dl class="booking-summary__list" aria-live="polite">
          <div><dt>Prestation</dt><dd data-sum-service>À choisir</dd></div>
          <div data-sum-options-row hidden><dt>Options</dt><dd data-sum-options></dd></div>
          <div><dt>Durée estimée</dt><dd class="num" data-sum-duration>–</dd></div>
          <div><dt>Prix estimé</dt><dd class="num" data-sum-price>–</dd></div>
          <div><dt>Date</dt><dd data-sum-date>À choisir</dd></div>
        </dl>
      </aside>
    </div>
  </div>
</section>
