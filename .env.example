# ---------------------------------------------------------------
# L'Atelier des Locks : variables d'environnement
# Copier en .env (jamais commité) puis adapter.
# ---------------------------------------------------------------

# development | test | production
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
# URL publique du site (liens des emails, canonical, sitemap)
PUBLIC_URL=http://localhost:3000

# PostgreSQL (docker compose : service "db")
DATABASE_URL=postgres://atelier:atelier_dev@localhost:5432/atelier_des_locks
# Utilisés par docker-compose.yml pour créer la base locale
POSTGRES_USER=atelier
POSTGRES_PASSWORD=atelier_dev
POSTGRES_DB=atelier_des_locks
DB_PORT=5432

# Secret de signature des cookies de session (32 caractères minimum)
# Générer : node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=remplacer-par-une-valeur-aleatoire-de-48-octets-minimum

# Réservation : internal (notre module) | fresha_link (boutons vers Fresha)
BOOKING_PROVIDER=internal
# Obligatoire si BOOKING_PROVIDER=fresha_link
FRESHA_BOOKING_URL=

# Page /styleguide : activée par défaut hors production, désactivée en production.
# Décommenter pour forcer (true | false).
# STYLEGUIDE_ENABLED=true

# --- Phases suivantes (laisser vide pour l'instant) ---
# BREVO_API_KEY=
# BREVO_SENDER_EMAIL=
# SMS_SENDER=AtelierLock
# GOOGLE_REVIEW_URL=
