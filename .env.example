# ---------------------------------------------------------------
# L'Atelier des Locks : variables d'environnement
# Copier en .env (jamais commité) puis adapter.
# ---------------------------------------------------------------

# development | test | production
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
# URL publique du site (liens des emails, canonical, sitemap)
PUBLIC_URL=http://localhost:3000

# PostgreSQL (docker compose : service "db")
DATABASE_URL=postgres://atelier:atelier_dev@localhost:5432/atelier_des_locks
# Utilisés par docker-compose.yml pour créer la base locale
POSTGRES_USER=atelier
POSTGRES_PASSWORD=atelier_dev
POSTGRES_DB=atelier_des_locks
DB_PORT=5432

# Secret de signature des cookies de session (32 caractères minimum)
# Générer : node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=remplacer-par-une-valeur-aleatoire-de-48-octets-minimum

# Réservation : internal (notre module) | fresha_link (boutons vers Fresha)
# Tentatives de connexion à /admin par IP et par 10 minutes (défaut 10)
# ADMIN_LOGIN_RATE_LIMIT=10

BOOKING_PROVIDER=internal
# Obligatoire si BOOKING_PROVIDER=fresha_link
FRESHA_BOOKING_URL=
# Flux iCal privé (/agenda/<jeton>.ics) à ajouter à votre téléphone ou Google Agenda.
# 32 caractères minimum, même commande que SESSION_SECRET. Vide = flux désactivé.
ICAL_FEED_TOKEN=
# Photos des cheveux envoyées à la réservation (hors du webroot, ignoré par git)
UPLOAD_DIR=storage/uploads
# Réservations acceptées par adresse IP toutes les 10 minutes
BOOKING_RATE_LIMIT=5

# Page /styleguide : activée par défaut hors production, désactivée en production.
# Décommenter pour forcer (true | false).
# STYLEGUIDE_ENABLED=true

# --- Notifications (§7.6) ---
# console : les emails et SMS s'affichent dans le terminal (dev, tests). brevo : envoi réel.
NOTIFICATIONS_PROVIDER=console
# Obligatoires avec NOTIFICATIONS_PROVIDER=brevo. L'expéditeur doit être validé dans Brevo (SPF, DKIM).
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=L'Atelier des Locks
# Expéditeur alphanumérique des SMS : 11 caractères maximum, sans espace
SMS_SENDER=AtelierLock
# Adresse qui reçoit l'alerte « nouveau rendez-vous » (la propriétaire). Vide = pas d'alerte.
OWNER_EMAIL=
# Lien « Laisser un avis Google » (page /avis et remerciement). Vide = pas de lien.
GOOGLE_REVIEW_URL=
